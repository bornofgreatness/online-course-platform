# Supabase: pooler :6543?pgbouncer=true for runtime; :5432 (or direct host) for migrations
DATABASE_URL="postgresql://user:password@localhost:5432/course_platform"
DIRECT_URL="postgresql://user:password@localhost:5432/course_platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999999999"
NEXT_PUBLIC_STRIPE_ENABLED="true"
NEXT_PUBLIC_MERCADOPAGO_ENABLED="false"
NEXT_PUBLIC_S3_PUBLIC_URL_BASE=""

# Supabase Storage (preferred for admin uploads — create public bucket in dashboard)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="course-files"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"
REQUIRE_EMAIL_VERIFICATION="true"

# Digital certificate issuance (CONECT CURSOS — R$ 19.99 via Stripe)
CERTIFICATE_FEE_ENABLED="true"
# Set to "true" only to let ADMIN/SUPER_ADMIN skip the fee (default: admins pay too)
# CERTIFICATE_FEE_WAIVE_ADMIN="false"

# Stripe (Checkout — card by default; enable PIX in Dashboard then set card,pix)
STRIPE_SECRET_KEY="sk_test_your_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_key"
STRIPE_CHECKOUT_PAYMENT_METHODS="card"

# Mercado Pago (PIX + cartão) — https://www.mercadopago.com.br/developers
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
MERCADOPAGO_SANDBOX="true"

# AWS S3 (vídeos e PDFs)
AWS_REGION="sa-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
S3_BUCKET_NAME="your_bucket_name"

# Resend (verificação de e-mail + campanhas)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Plataforma <noreply@seudominio.com>"
